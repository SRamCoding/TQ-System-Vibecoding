---
// El cajetín de la lámina: qué documento es, su número, de dónde sale y cómo cambiarlo.
import Logo from './Logo.astro';
import { enGithub, REPO, RAMA } from '../lib/rutas.mjs';

interface Props {
  titulo: string;
  codigo: string;
  seccion: string;
  /** Archivo dentro del repositorio (docs/… o sitio/…). */
  archivo: string;
  /** Si el contenido sale de un documento editable (no de una página armada por el sitio). */
  editable?: boolean;
}
const { titulo, codigo, seccion, archivo, editable = true } = Astro.props;
const historial = `${REPO}/commits/${RAMA}/${archivo}`;
---
<dl class="cajetin" aria-label="Datos de la lámina" data-pagefind-ignore>
  <div class="c-logo"><Logo /></div>
  <div class="c-doc"><dt>Documento</dt><dd>{titulo}</dd></div>
  <div class="c-num"><dt>Lámina</dt><dd>{codigo}</dd></div>
  <div class="c-arch"><dt>Archivo</dt><dd><code>{archivo}</code></dd></div>
  <div class="c-sec"><dt>Sección</dt><dd>{seccion}</dd></div>
  <div class="c-acc">
    <dt>En GitHub</dt>
    <dd>
      <a href={enGithub(archivo)}>Ver la fuente</a>
      {editable && <a href={enGithub(archivo, true)}>Proponer un cambio</a>}
      <a href={historial}>Historial de cambios</a>
    </dd>
  </div>
</dl>

<style>
  .cajetin {
    margin: 3.5rem 0 0 auto;
    max-width: 40rem;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 7rem;
    grid-template-areas:
      'logo doc num'
      'logo arch sec'
      'acc acc acc';
    border: 1.5px solid var(--marco);
    font-size: 0.86rem;
    line-height: 1.3;
  }
  .cajetin > div {
    padding: 0.45rem 0.65rem;
    min-width: 0;
    box-shadow: 1px 0 0 0 var(--marco), 0 1px 0 0 var(--marco);
  }
  .c-logo { grid-area: logo; display: grid; place-items: center; }
  .c-logo :global(svg) { width: 2.75rem; height: auto; }
  .c-doc { grid-area: doc; }
  .c-num { grid-area: num; }
  .c-arch { grid-area: arch; }
  .c-sec { grid-area: sec; }
  .c-acc { grid-area: acc; }
  dt {
    font: 500 0.84rem/1.1 var(--f-rotulo);
    color: var(--lapiz);
    letter-spacing: 0.02em;
  }
  dd {
    margin: 0.2rem 0 0;
    overflow-wrap: anywhere;
  }
  .c-doc dd { font: 600 1.1rem/1.15 var(--f-rotulo); }
  .c-num dd { font: 700 1.6rem/1 var(--f-rotulo); }
  .c-arch code { font-size: 0.78rem; background: none; padding: 0; }
  .c-acc dd { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; }

  @media (max-width: 640px) {
    .cajetin {
      grid-template-columns: minmax(0, 1fr) 6rem;
      grid-template-areas:
        'doc num'
        'arch arch'
        'sec sec'
        'acc acc';
    }
    .c-logo { display: none; }
  }
</style>
