---
// La carátula: el proyecto de punta a punta. Todo lo que muestra sale de docs/ al construir.
import Base from '../layouts/Base.astro';
import Cajetin from '../components/Cajetin.astro';
import { bloques, capitulos, decisiones, escala, etapas, fechaCorta, planes } from '../lib/proyecto';
import { cargar, url } from '../lib/sitio';
import { resolverEnlace } from '../lib/rutas.mjs';
import path from 'node:path';
import { DOCS } from '../lib/rutas.mjs';

const { docs } = await cargar();
const hist = docs.get('analisis/historia.md')!;
const caps = await capitulos();
const estado = await bloques();
const pasos = await escala();
const obra = await etapas();
const todosPlanes = await planes();
const adrs = await decisiones();

const cerrados = todosPlanes.filter((p) => !p.activo);
const activos = todosPlanes.filter((p) => p.activo);
const abiertas = adrs.filter((d) => d.tipo === 'propuesta');
const hechas = obra.tareas.filter((t) => t.hecha);
const porHacer = obra.tareas.filter((t) => !t.hecha);
const ultimoPlan = cerrados[0];

/** «ERP 0.1 y 0.2 · CRM 0.2» → piezas con su área, para pintarlas. */
const versiones = (s: string) =>
  s
    .split('·')
    .map((t) => t.trim())
    .filter(Boolean)
    .map((t) => ({
      texto: t,
      area: /^crm/i.test(t) ? 'crm' : /^erp/i.test(t) ? 'erp' : /^com[uú]n/i.test(t) ? 'comun' : '',
    }));

/** Posición de una versión en la escala de madurez (0.4.2 → índice de 0.4). */
const indiceEnEscala = (v: string) => {
  const mayor = v.split('.').slice(0, 2).join('.');
  const i = pasos.findIndex((p) => p.version === mayor);
  return i < 0 ? 0 : i;
};

const enlaceBloque = (e: string) => resolverEnlace(e, path.join(DOCS, 'analisis/README.md')) ?? '#';
const NOMBRE_AREA: Record<string, string> = { crm: 'CRM', erp: 'ERP', comun: 'Común' };
---
<Base titulo="Portada" fija="portada" descripcion="TechQuk Integral System: el ERP + CRM propio de Techquk S.A.C., de la idea a la construcción.">
  <p class="ruta-archivo">Lámina 00 · carátula del proyecto</p>

  <header class="caratula">
    <p class="quien">TechQuk Integral System, el ERP + CRM propio de Techquk S.A.C.</p>
    <h1>¿Cuánto se gana realmente en cada proyecto?</h1>
    <p class="entrada">
      Esa pregunta justifica todo el sistema. Techquk es un integrador tecnológico de Chiclayo que gana sus contratos por
      licitación y los ejecuta como proyectos; S10 registra compras y presupuestos, pero no responde eso de forma directa.
      Aquí está el proyecto completo: de dónde salió, qué se descartó, qué se decidió y por qué, y qué se está
      construyendo hoy.
    </p>
  </header>

  <section class="bloque-portada" aria-labelledby="recorrido">
    <div class="encabezado">
      <h2 id="recorrido">El recorrido</h2>
      <a href={url(hist.ruta)}>Leer la historia completa</a>
    </div>
    <ol class="montante">
      {caps.map((c) => (
        <li>
          <span class="nodo" aria-hidden="true"></span>
          <p class="cuando">{c.cuando || 'El origen'}</p>
          <h3><a href={`${url(hist.ruta)}#${c.ancla}`}>{c.que.charAt(0).toUpperCase() + c.que.slice(1)}</a></h3>
          <p class="resumen">{c.resumen}</p>
          {c.versiones && (
            <p class="versiones">
              {versiones(c.versiones).map((v) => (v.area ? <span class={`v v-${v.area}`}>{v.texto}</span> : <span class="v-nota">{v.texto}</span>))}
            </p>
          )}
        </li>
      ))}
      {obra.actual && (
        <li class="hoy">
          <span class="nodo" aria-hidden="true"></span>
          <p class="cuando">Hoy{ultimoPlan ? `, ${fechaCorta(ultimoPlan.fecha)}` : ''}</p>
          <h3><a href="/construccion/">Etapa {obra.actual.n} · {obra.actual.nombre}</a></h3>
          <p class="resumen">
            {hechas.length} de {obra.tareas.length} tareas cerradas.
            {ultimoPlan && <> La última: <a href={url(ultimoPlan.doc.ruta)}>{ultimoPlan.titulo}</a>.</>}
            {porHacer[0] && <> Sigue la {porHacer[0].id}: {porHacer[0].desc.replace(/\.$/, '')}.</>}
          </p>
        </li>
      )}
    </ol>
  </section>

  <section class="bloque-portada" aria-labelledby="madurez">
    <div class="encabezado">
      <h2 id="madurez">Qué tan maduro está cada bloque</h2>
      <a href={url('analisis')}>Estado del análisis{estado.al ? `, al ${estado.al}` : ''}</a>
    </div>
    <p class="nota-escala">
      El número no cuenta ediciones: dice en qué etapa está cada parte del análisis. Ninguna llegó todavía a
      la línea base (1.0), que es lo que la empresa acuerda construir.
    </p>
    <div class="bloques">
      {estado.lista.map((b) => {
        const i = indiceEnEscala(b.version);
        return (
          <article class={`bloque area-${b.area}`}>
            <h3><a href={enlaceBloque(b.enlace)}>{b.nombre}</a> <span>{b.que}</span></h3>
            <p class="version"><strong>{b.version}</strong> {b.etapa}</p>
            <ol class="escala" aria-label={`Escala de madurez: ${b.nombre} está en ${b.etapa}`}>
              {pasos.map((p, j) => (
                <li class={j < i ? 'pasado' : j === i ? 'aqui' : ''} aria-current={j === i ? 'step' : undefined}>
                  <span>{p.version}</span> {p.etapa}
                </li>
              ))}
            </ol>
            <p class="sigue"><span>Qué sigue.</span> {b.sigue}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="bloque-portada" aria-labelledby="obra">
    <div class="encabezado">
      <h2 id="obra">La construcción, por etapas</h2>
      <a href="/construccion/">Planes y bitácoras</a>
    </div>
    <ol class="etapas">
      {obra.lista.map((e) => (
        <li class={e.cerrada ? 'cerrada' : e === obra.actual ? 'actual' : ''}>
          <span class="num">Etapa {e.n}</span>
          <strong>{e.nombre}</strong>
          <span class="estado">
            {e.cerrada ? <span class="sello ok">Cerrada{e.fecha ? ` ${fechaCorta(e.fecha)}` : ''}</span>
              : e === obra.actual ? <span class="sello en-curso">En curso · {hechas.length}/{obra.tareas.length}</span>
              : <span class="sello">Por abrir</span>}
          </span>
        </li>
      ))}
    </ol>
    {obra.actual && (
      <p class="medidor" aria-hidden="true">
        {obra.tareas.map((t) => <span class={t.hecha ? 'hecha' : ''} title={`${t.id}${t.hecha ? ' · cerrada' : ''}`}></span>)}
      </p>
    )}
  </section>

  <div class="dos-columnas">
    <section aria-labelledby="movimientos">
      <h2 id="movimientos">Planes recientes</h2>
      <ul class="lista-corta">
        {activos.map((p) => (
          <li><span class="f">{fechaCorta(p.fecha)}</span><a href={url(p.doc.ruta)}>{p.titulo}</a><span class="sello en-curso">En curso</span></li>
        ))}
        {cerrados.slice(0, 6).map((p) => (
          <li><span class="f">{fechaCorta(p.fecha)}</span><a href={url(p.doc.ruta)}>{p.titulo}</a></li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="abiertas">
      <h2 id="abiertas">Decisiones por tomar</h2>
      <ul class="lista-corta">
        {abiertas.map((d) => (
          <li><span class="f">ADR {d.numero}</span><a href={url(d.doc.ruta)}>{d.titulo}</a><span class="sello pendiente">Propuesta</span></li>
        ))}
        <li><span class="f">Lista</span><a href={url('decisiones/pendientes')}>Pendientes que esperan a Gerencia y a las áreas</a></li>
      </ul>
    </section>
  </div>

  <section class="bloque-portada" aria-labelledby="empezar">
    <h2 id="empezar">Por dónde entrar</h2>
    <dl class="entradas">
      <div><dt>Es la primera vez</dt><dd><a href={url(hist.ruta)}>La historia</a>, en unos minutos: de dónde viene el sistema y qué se descartó.</dd></div>
      <div><dt>Quiero saber qué hace un flujo</dt><dd><a href={url('diseno/v4')}>La especificación v4</a>, por partes, con sus escenarios de aceptación.</dd></div>
      <div><dt>Quiero saber por qué es así</dt><dd><a href="/decisiones/">Las decisiones</a>, cada una con su contexto y lo que se descartó.</dd></div>
      <div><dt>Voy a construir algo</dt><dd><a href={url('planes/mapa-etapas')}>El mapa de etapas</a> y las <a href={url('convenciones')}>convenciones</a>, que mandan sobre todo lo demás.</dd></div>
      <div><dt>No entiendo un término</dt><dd><a href={url('glosario')}>El glosario</a>: negocio, obra pública y contexto peruano.</dd></div>
    </dl>
  </section>

  <Cajetin titulo="Carátula del proyecto" codigo="00" seccion="Portada" archivo="sitio/src/pages/index.astro" editable={false} />
</Base>

<style>
  .caratula {
    max-width: 56rem;
    padding-bottom: 2.25rem;
    border-bottom: 1.5px solid var(--marco);
  }
  .quien {
    margin: 0 0 0.75rem;
    font: 600 1.2rem/1.2 var(--f-rotulo);
    color: var(--turquesa-texto);
  }
  .caratula h1 {
    margin: 0 0 1.25rem;
    font: 700 clamp(2.6rem, 1.4rem + 5vw, 5.4rem) / 0.95 var(--f-rotulo);
    letter-spacing: -0.005em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .entrada {
    margin: 0;
    max-width: 44rem;
    font-size: 1.15rem;
    color: var(--tinta-suave);
  }

  .bloque-portada {
    margin-top: 3rem;
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  h2 {
    margin: 0;
    font: 600 2rem/1.1 var(--f-rotulo);
    color: var(--tinta);
  }
  .dos-columnas h2,
  #empezar {
    margin-bottom: 1rem;
  }

  /* ---- El recorrido como montante: un cable vertical con cada hito conectado ---- */
  .montante {
    --x: 0.6rem;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 2.6rem;
    max-width: 52rem;
  }
  .montante::before {
    content: '';
    position: absolute;
    left: var(--x);
    top: 0.55rem;
    bottom: 1.6rem;
    width: 3px;
    background: var(--turquesa);
    transform-origin: top;
    animation: tender 1.4s cubic-bezier(0.3, 0.7, 0.2, 1) both;
  }
  @keyframes tender {
    from { transform: scaleY(0); }
  }
  .montante li {
    position: relative;
    padding: 0 0 1.6rem;
  }
  .nodo {
    position: absolute;
    left: calc(var(--x) - 2.6rem - 0.45rem + 1.5px);
    top: 0.45rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--lamina);
    border: 2px solid var(--marco);
  }
  .nodo::after {
    content: '';
    position: absolute;
    left: 100%;
    top: calc(50% - 1px);
    width: 1.25rem;
    height: 2px;
    background: var(--marco);
  }
  .cuando {
    margin: 0;
    font: 600 1rem/1.2 var(--f-rotulo);
    color: var(--turquesa-texto);
    letter-spacing: 0.02em;
  }
  .montante h3 {
    margin: 0.1rem 0 0.3rem;
    font: 600 1.45rem/1.15 var(--f-rotulo);
  }
  .montante h3 a {
    color: var(--tinta);
    text-decoration: none;
  }
  .montante h3 a:hover {
    color: var(--enlace-hover);
    text-decoration: underline;
  }
  .resumen {
    margin: 0;
    color: var(--tinta-suave);
    max-width: 44rem;
  }
  .versiones {
    margin: 0.45rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .v {
    font: 600 0.88rem/1 var(--f-rotulo);
    padding: 0.22rem 0.45rem 0.18rem;
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    color: var(--tinta);
  }
  .v-crm { --c: var(--area-crm); }
  .v-erp { --c: var(--area-erp); }
  .v-comun { --c: var(--area-comun); }
  .v-nota {
    font-size: 0.88rem;
    color: var(--lapiz);
    font-style: italic;
  }
  .hoy .nodo {
    background: var(--turquesa);
    border-color: var(--turquesa);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--turquesa) 30%, transparent);
  }
  .hoy .cuando {
    color: var(--tinta);
  }

  /* ---- Madurez de los bloques ---- */
  .nota-escala {
    margin: -0.5rem 0 1.25rem;
    color: var(--tinta-suave);
    max-width: 44rem;
  }
  .bloques {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1.5px solid var(--marco);
  }
  .bloque {
    padding: 1rem 1.1rem 1.1rem;
    border-top: 5px solid var(--c);
    min-width: 0;
  }
  .bloque + .bloque {
    border-left: 1px solid var(--marco);
  }
  .area-crm { --c: var(--area-crm); }
  .area-erp { --c: var(--area-erp); }
  .area-comun { --c: var(--area-comun); }
  .bloque h3 {
    margin: 0;
    font: 700 1.6rem/1.1 var(--f-rotulo);
  }
  .bloque h3 span {
    display: block;
    font: 500 1rem/1.3 var(--f-rotulo);
    color: var(--lapiz);
  }
  .bloque h3 a {
    color: var(--tinta);
  }
  .version {
    margin: 0.6rem 0 0.5rem;
    font: 500 1.05rem/1 var(--f-rotulo);
    color: var(--tinta-suave);
  }
  .version strong {
    font: 700 2.4rem/1 var(--f-rotulo);
    color: var(--tinta);
    margin-right: 0.35rem;
  }
  .escala {
    list-style: none;
    margin: 0 0 0.8rem;
    padding: 0;
    display: grid;
    gap: 2px;
    font-size: 0.85rem;
    line-height: 1.2;
  }
  .escala li {
    display: flex;
    gap: 0.5rem;
    padding: 0.22rem 0.45rem;
    color: var(--lapiz);
    border-left: 3px solid var(--regla);
  }
  .escala li span {
    font: 600 0.88rem/1.2 var(--f-rotulo);
    min-width: 1.6rem;
  }
  .escala .pasado {
    border-left-color: var(--c);
    color: var(--tinta-suave);
  }
  .escala .aqui {
    border-left-color: var(--c);
    background: color-mix(in srgb, var(--c) 16%, transparent);
    color: var(--tinta);
    font-weight: 700;
  }
  .sigue {
    margin: 0;
    font-size: 0.92rem;
    color: var(--tinta-suave);
  }
  .sigue span {
    font-weight: 700;
    color: var(--tinta);
  }

  /* ---- Etapas ---- */
  .etapas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1.5px solid var(--marco);
  }
  .etapas li {
    padding: 0.8rem 0.75rem;
    display: grid;
    gap: 0.25rem;
    align-content: start;
    min-width: 0;
  }
  .etapas li + li {
    border-left: 1px solid var(--marco);
  }
  .etapas .num {
    font: 500 0.92rem/1 var(--f-rotulo);
    color: var(--lapiz);
  }
  .etapas strong {
    font: 600 1.2rem/1.1 var(--f-rotulo);
  }
  .etapas .cerrada {
    background: color-mix(in srgb, var(--ok) 7%, transparent);
  }
  .etapas .actual {
    background: color-mix(in srgb, var(--turquesa) 13%, transparent);
    box-shadow: inset 0 -4px 0 var(--turquesa);
  }
  .medidor {
    display: flex;
    gap: 3px;
    margin: 0.75rem 0 0;
  }
  .medidor span {
    flex: 1;
    height: 0.5rem;
    background: var(--regla);
  }
  .medidor .hecha {
    background: var(--turquesa);
  }

  /* ---- Columnas finales ---- */
  .dos-columnas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 3rem;
  }
  .lista-corta {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--marco);
  }
  .lista-corta li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--regla);
  }
  .lista-corta .f {
    font: 500 0.95rem var(--f-rotulo);
    color: var(--lapiz);
  }

  .entradas {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    border-top: 1.5px solid var(--marco);
  }
  .entradas div {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--regla);
  }
  .entradas dt {
    font: 600 1.15rem/1.2 var(--f-rotulo);
  }
  .entradas dd {
    margin: 0.2rem 0 0;
    color: var(--tinta-suave);
  }

  @media (max-width: 1100px) {
    .etapas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .etapas li:nth-child(4) {
      border-left: 0;
    }
    .etapas li:nth-child(n + 4) {
      border-top: 1px solid var(--marco);
    }
  }
  @media (max-width: 860px) {
    .bloques {
      grid-template-columns: minmax(0, 1fr);
    }
    .bloque + .bloque {
      border-left: 0;
      border-top: 5px solid var(--c);
      box-shadow: 0 -1px 0 var(--marco);
    }
    .dos-columnas,
    .entradas {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .etapas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .etapas li:nth-child(n) {
      border-left: 0;
      border-top: 1px solid var(--marco);
    }
    .etapas li:nth-child(even) {
      border-left: 1px solid var(--marco);
    }
    .etapas li:nth-child(-n + 2) {
      border-top: 0;
    }
    .montante {
      padding-left: 2.2rem;
    }
    .nodo {
      left: calc(var(--x) - 2.2rem - 0.45rem + 1.5px);
    }
    .nodo::after {
      width: 0.85rem;
    }
    .lista-corta li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.1rem 0.75rem;
    }
    .lista-corta .f {
      grid-column: 1 / -1;
    }
  }
</style>
