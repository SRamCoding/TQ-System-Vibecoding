APP_NAME=TechQuk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Fechas de negocio (vencimientos, penalidades, plazos) se calculan en hora de Lima.
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
# Días que se conservan los registros diarios: a confirmar con TI (docs/decisiones/pendientes.md).
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Credenciales solo de desarrollo: coinciden con docker-compose.yml y con CI.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=techquk
DB_USERNAME=techquk
DB_PASSWORD=techquk

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sistema@techquk.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Respaldo a S3 (spatie/laravel-backup). La región depende de Asistencia Legal (pendientes.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Respaldos (plan 1.12): la clave de cifrado la genera y guarda TI fuera del servidor; sin ella no hay respaldo.
# Destino: respaldos (local, en amarillo en la página de salud) o respaldos_s3 con las RESPALDOS_S3_* de TI.
BACKUP_ARCHIVE_PASSWORD=
RESPALDOS_DISCO=respaldos
# RESPALDOS_S3_KEY=
# RESPALDOS_S3_SECRET=
# RESPALDOS_S3_REGION=
# RESPALDOS_S3_BUCKET=

# Latido del programador hacia Healthchecks (plan 1.12): la URL la da TI. Vacía, el latido solo se anota en la base.
SALUD_LATIDO_URL=

# Modo desarrollo (plan 1.4i): solo en tu equipo, con APP_ENV=local y APP_DEBUG=true. Nunca en el servidor.
# TECHQUK_MODO_DESARROLLO=true

# Usuario para iniciar sesión en desarrollo (solo APP_ENV=local; clave: Clave-de-prueba1). Sin estas líneas: dev@techquk.test.
# DEV_USER_NOMBRES=
# DEV_USER_APELLIDOS=
# DEV_USER_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Consulta de validez de comprobantes de SUNAT (API de consulta integrada). Sin estas, la validación es simulada.
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_RUC=
# La lectura de notas por foto usa IA_CLAVE_ANTHROPIC (como el resto de la IA del núcleo).

# Datos abiertos de contrataciones del OECE (estándar OCDS). MV-066: la API vigente, la misma que usa Kingfisher Collect
# (Open Contracting Partnership); «releases» llega de lo más nuevo a lo más viejo, 20 por página (links.next), sin «since».
OECE_OCDS_URL=https://contratacionesabiertas.oece.gob.pe/api/v1/releases
